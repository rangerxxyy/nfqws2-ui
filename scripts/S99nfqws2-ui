#!/bin/sh

APP=/opt/share/nfqws2-ui/current
RUN=/opt/var/run/nfqws2-ui
LOG=/opt/var/log/nfqws2-ui.log
PIDFILE="$RUN/pid"
PORT_FILE=/opt/var/run/nfqws2-ui.port

is_our_process() {
	[ -r "$PIDFILE" ] || return 1
	pid=$(cat "$PIDFILE" 2>/dev/null)
	case "$pid" in ''|*[!0-9]*) return 1 ;; esac
	[ "$pid" -gt 1 ] 2>/dev/null || return 1
	[ -r "/proc/$pid/cmdline" ] || return 1
	cmd=$(tr '\000' ' ' < "/proc/$pid/cmdline" 2>/dev/null)
	case "$cmd" in *"$APP/bin/nfqws2-ui"*) return 0 ;; esac
	return 1
}

port_is_listening() {
	port=$1
	case "$port" in ''|*[!0-9]*) return 2 ;; esac
	[ "$port" -ge 1 ] 2>/dev/null && [ "$port" -le 65535 ] 2>/dev/null || return 2
	port_hex=$(printf '%04X' "$port") || return 2
	seen_table=0
	for table in /proc/net/tcp /proc/net/tcp6; do
		[ -r "$table" ] || continue
		seen_table=1
		awk -v port=":$port_hex" '$2 ~ (port "$") && $4 == "0A" { found=1 } END { exit !found }' "$table" && return 0
	done
	[ "$seen_table" -eq 1 ] && return 1
	return 2
}

report_status() {
	if ! is_our_process; then echo "nfqws2-ui is stopped"; return 1; fi
	pid=$(cat "$PIDFILE" 2>/dev/null)
	if [ ! -r "$PORT_FILE" ]; then
		echo "nfqws2-ui process is running (PID $pid), but port is unknown"
		return 1
	fi
	port=$(cat "$PORT_FILE" 2>/dev/null)
	port_is_listening "$port"
	result=$?
	if [ "$result" -ne 0 ]; then
		if [ "$result" -eq 2 ]; then
			echo "nfqws2-ui process is running (PID $pid), but port $port could not be checked"
		else
			echo "nfqws2-ui process is running (PID $pid), but port $port is not listening"
		fi
		return 1
	fi
	echo "nfqws2-ui is running (PID $pid, port $port is listening)"
}

start_service() {
	if is_our_process; then echo "nfqws2-ui already running (PID $(cat "$PIDFILE"))"; return 0; fi
	umask 077
	mkdir -p "$RUN" /opt/var/log || return 1
	[ -x "$APP/bin/nfqws2-ui" ] || { echo "nfqws2-ui binary not found: $APP/bin/nfqws2-ui"; return 1; }
	rm -f "$PIDFILE"
	"$APP/bin/nfqws2-ui" >>"$LOG" 2>&1 </dev/null &
	pid=$!
	tries=0
	while [ "$tries" -lt 5 ]; do
		if kill -0 "$pid" 2>/dev/null; then
			printf '%s\n' "$pid" > "$PIDFILE"
			if is_our_process; then echo "nfqws2-ui started (PID $pid)"; return 0; fi
		fi
		tries=$((tries + 1))
		sleep 1
	done
	rm -f "$PIDFILE"
	echo "nfqws2-ui failed to start; see $LOG"
	return 1
}

stop_service() {
	if ! is_our_process; then rm -f "$PIDFILE"; echo "nfqws2-ui is stopped"; return 0; fi
	pid=$(cat "$PIDFILE")
	kill "$pid" 2>/dev/null || return 1
	tries=0
	while kill -0 "$pid" 2>/dev/null && [ "$tries" -lt 10 ]; do
		sleep 1
		tries=$((tries + 1))
	done
	if kill -0 "$pid" 2>/dev/null; then kill -9 "$pid" 2>/dev/null || return 1; fi
	rm -f "$PIDFILE"
	echo "nfqws2-ui stopped"
}

case "${1:-}" in
	start) start_service ;;
	stop) stop_service ;;
	restart) stop_service && start_service ;;
	status)
		report_status
		;;
	*) echo "Usage: $0 {start|stop|restart|status}"; exit 2 ;;
esac
